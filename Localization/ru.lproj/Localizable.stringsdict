			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>и ещё %lld</string>
			<key>few</key>
			<string>и ещё %lld</string>
			<key>many</key>
			<string>и ещё %lld</string>
			<key>other</key>
			<string>и ещё %lld</string>
		</dict>
	</dict>
	<key>errors.atMost %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
