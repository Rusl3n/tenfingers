<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key><string>local.tenfingers</string>
    <key>CFBundleName</key><string>TenFingers</string>
    <key>CFBundleDisplayName</key><string>TenFingers</string>
    <key>CFBundleDevelopmentRegion</key><string>en</string>
    <key>CFBundleLocalizations</key><array><string>ru</string><string>en</string></array>
    <key>LSHasLocalizedDisplayName</key><true/>
    <key>CFBundleExecutable</key><string>TenFingers</string>
    <key>CFBundleIconFile</key><string>AppIcon</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <!-- Версию, номер сборки, TFGitCommit и TFSchemaGeneration (поколение схемы базы) подставляет scripts/make-bundle.sh в копию внутри .app; здесь заглушки. -->
    <key>CFBundleShortVersionString</key><string>0.0.0</string>
    <key>CFBundleVersion</key><string>0</string>
    <key>LSMinimumSystemVersion</key><string>15.0</string>
    <key>LSApplicationCategoryType</key><string>public.app-category.education</string>
    <key>NSHighResolutionCapable</key><true/>
    <!-- Ссылки tenfingers://home, course, achievements: так виджет открывает разделы приложения. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key><string>local.tenfingers</string>
            <key>CFBundleURLSchemes</key><array><string>tenfingers</string></array>
        </dict>
    </array>
    <!-- Файл прогресса (экспорт и импорт в «Настройки → Данные»): JSON с расширением .tenfingers. -->
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key><string>local.tenfingers.progress</string>
            <key>UTTypeDescription</key><string>Ten Fingers Progress</string>
            <key>UTTypeConformsTo</key><array><string>public.json</string></array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key><array><string>tenfingers</string></array>
            </dict>
        </dict>
    </array>
</dict>
</plist>
